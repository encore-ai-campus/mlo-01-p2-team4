{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hr-silver/v1/phase4-output.schema.json",
  "title": "HR Silver Phase 4 output",
  "description": "Accepted and rejected rows with input accounting. Accounting rule: input_count = accepted_count + rejected_count + excluded_count.",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "accepted", "rejected", "metrics"],
  "properties": {
    "context": {"$ref": "source-batch-transport.schema.json#/$defs/context"},
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineage", "business", "record_fingerprint"],
        "properties": {
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "source_row_no", "source_record_sha256", "release_slot", "scheduled_release_at"],
            "properties": {
              "record_id": {"type": "integer"},
              "source_row_no": {"type": "integer", "minimum": 1},
              "source_record_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "release_slot": {"type": "integer", "minimum": 0},
              "scheduled_release_at": {"type": "string", "format": "date-time"}
            }
          },
          "business": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "area_id", "area_name", "parent_area_id", "parent_area_name", "top_area_id",
              "top_area_name", "top_area_level_code", "employee_id", "employee_name",
              "employee_department_name", "employee_position_name", "employee_hire_datetime",
              "employee_status_code", "area_registration_date", "top_area_registration_date"
            ],
            "properties": {
              "area_id": {"type": "string", "pattern": "^BIZ_[0-9]{5}$"},
              "area_name": {"type": "string", "minLength": 1},
              "parent_area_id": {"type": ["string", "null"], "pattern": "^BIZ_[0-9]{5}$"},
              "parent_area_name": {"type": ["string", "null"], "minLength": 1},
              "top_area_id": {"type": "string", "pattern": "^BIZ_[0-9]{5}$"},
              "top_area_name": {"type": "string", "minLength": 1},
              "top_area_level_code": {"type": "string", "const": "TOP_LEVEL"},
              "employee_id": {"type": "string", "pattern": "^EMP[0-9]{6}$"},
              "employee_name": {"type": "string", "minLength": 1},
              "employee_department_name": {"type": "string", "minLength": 1},
              "employee_position_name": {"type": "string", "minLength": 1},
              "employee_hire_datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
              "employee_status_code": {"type": "string", "enum": ["ACTIVE", "INACTIVE"]},
              "area_registration_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
              "top_area_registration_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
            }
          },
          "record_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observed_lineage", "raw_json", "violations"],
        "properties": {
          "observed_lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["batch_record_index", "record_id", "source_row_no", "source_record_sha256", "release_slot", "scheduled_release_at"],
            "properties": {
              "batch_record_index": {"type": "integer", "minimum": 1},
              "record_id": {"type": ["integer", "null"]},
              "source_row_no": {"type": ["integer", "null"]},
              "source_record_sha256": {"type": ["string", "null"]},
              "release_slot": {"type": ["integer", "null"]},
              "scheduled_release_at": {"type": ["string", "null"]}
            }
          },
          "raw_json": {"type": "string", "minLength": 2},
          "violations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "rule_id", "field", "detail"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "rule_id": {"type": "string", "minLength": 1},
                "field": {"type": ["string", "null"]},
                "detail": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_count", "accepted_count", "rejected_count", "excluded_count"],
      "properties": {
        "input_count": {"type": "integer", "minimum": 0},
        "accepted_count": {"type": "integer", "minimum": 0},
        "rejected_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
