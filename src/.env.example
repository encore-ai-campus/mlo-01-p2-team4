# 이 파일을 src/.env로 복사한 뒤 실제 실행 설정을 입력합니다.
PIPELINE_INTERVAL_SECONDS=30

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=internal_data
MONGODB_COLLECTION=records

MYSQL_DATABASE=실제_데이터베이스명
MYSQL_USER=실제_계정
MYSQL_PASSWORD=실제_비밀번호
MYSQL_HOST=실제_MySQL_주소
MYSQL_PORT=3306
